{
  "name": "nixllm-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NixLLM Dashboard — management UI for API keys, usage stats, and model catalog backed by PostgreSQL.",
  "scripts": {
    "dev": "vite --port 9173 --host",
    "build": "vite build",
    "preview": "vite preview --port 9173 --host",
    "lint": "eslint src --ext js,jsx --max-warnings 0",
    "test": "node --test 'src/**/*.test.js' 'src/**/*.test.jsx'",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "wrangler": "^4.60.0"
  }
}
