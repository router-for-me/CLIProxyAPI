# Dashboard dev-mode environment (Vite reads VITE_* vars at build/dev time).
# Copy to .env.local and adjust as needed.

# Upstream CLIProxyAPI server. The dev server proxies /v0/* here.
VITE_API_HOST=http://127.0.0.1:8317

# Note: the dashboard does NOT read MANAGEMENT_PASSWORD directly — it is
# configured on the Go server. The user enters it into the login form and
# the dashboard stores it in localStorage.
