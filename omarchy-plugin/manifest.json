{
    "schemaVersion": 1,
    "id": "chicken.proxy-usage",
    "name": "Usage",
    "version": "1.0.3",
    "author": "Local",
    "description": "Papa Proxy quotas and standalone Antigravity and Meta usage.",
    "kinds": ["bar-widget"],
    "entryPoints": {"barWidget": "UsagePanel.qml"},
    "barWidget": {
        "displayName": "Usage",
        "category": "AI",
        "allowMultiple": false,
        "defaults": {"autoRefresh": true, "authDir": ""},
        "schema": [
            {
                "key": "autoRefresh",
                "type": "boolean",
                "label": "Check every 15 minutes while open",
                "defaultValue": true
            },
            {
                "key": "authDir",
                "type": "path",
                "label": "Papa Proxy OAuth credential directory",
                "defaultValue": ""
            }
        ]
    }
}
