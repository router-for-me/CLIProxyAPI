# Binaries
cli-proxy-api
*.exe

# Configuration
config.yaml
.env

# Generated content
bin/*
/logs
conv/*
temp/*
refs/*
plugins/*
examples/plugin/bin/*

# Storage backends
pgstore/*
gitstore/*
objectstore/*

# Static assets
static/*

# Authentication data
auths/*
/auths
!auths/.gitkeep

# Documentation
docs/*
AGENTS.md
CLAUDE.md
GEMINI.md

# Tooling metadata
.vscode/*
.worktrees/
.codex/*
.claude/*
.claude
.gemini/*
.serena/*
.agent/*
.agents
.pi
.agents/*
.opencode/*
.idea/*
.beads/*
.bmad/*
_bmad/*
_bmad-output/*

# macOS
.DS_Store
._*
.gocache/

# Local artifacts
/server
/test-output
/.zcode/

# Dashboard build output + dependencies
web/dashboard/node_modules/
web/dashboard/dist/

# Cloudflare Workers local state — .wrangler/ is the wrangler cache and
# .dev.vars holds local-only secrets (e.g. BACKEND_ORIGIN for `wrangler dev`).
web/dashboard/.wrangler/
web/dashboard/.dev.vars

# Operator-supplied LiteLLM reference catalogs dropped into the repo root
# (e.g. model_prices_and_context_window.json) are intentionally NOT tracked;
# if an operator wants to import one they must do it through the dashboard's
# Pricing Sources upload flow, which stores it outside the working tree.
/model_prices_and_context_window.json

# Windows NTFS Alternate Data Stream leak — index-dependent artifacts
# produced when files cross the WSL/Windows boundary (Zone.Identifier
# marks the file's origin URL/security zone). Tracked as separate files
# by git, so we blank the pattern to ignore *:Zone.Identifier everywhere.
*:Zone.Identifier
