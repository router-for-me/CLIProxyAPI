# =============================================================================
# NixLLM production environment template.
#
#   cp .env.production.example .env   # then edit
#
# Everything below is optional — every key has a default in docker-compose.yml.
# Uncomment and set only what you want to override.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# NixLLM_CONTAINER_NAME=nixllm
# NIXLLM_PORT=8317                       # host port mapped to 8317 in the container
# NIXLLM_PULL_POLICY=always             # always | missing | never
# NIXLLM_RESTART=unless-stopped         | always | on-failure | no
# NIXLLM_STOP_GRACE=30s                 # graceful shutdown before SIGKILL
# NIXLLM_NETWORK_NAME=nixllm-net
# TZ=Asia/Shanghai

# OAuth callback ports — the server binds 0.0.0.0 on these for the in-browser
# OAuth flows. Comment the corresponding line in docker-compose.yml to disable.
# OAUTH_PORT_ANTHROPIC=54545
# OAUTH_PORT_CODEX=1455
# OAUTH_PORT_ANTIGRAVITY=51121

# Management API password (gates /v0/management + the dashboard login screen).
# Leave unset to disable the management API entirely (404 on all routes).
# MANAGEMENT_PASSWORD=replace-with-a-long-random-secret

# Optional AES-GCM key that seals the api_key_principal column of usage_events
# at rest. Unset = plaintext (legacy rows remain readable). 32-byte value.
# Generate with: openssl rand -base64 32
# PGSTORE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Bundled Postgres (`--profile full` only)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=change-me-to-a-long-random-secret  # REQUIRED for the `full` profile
# POSTGRES_USER=nixllm
# POSTGRES_DB=nixllm
# POSTGRES_TAG=17-bookworm              # pinned postgres image tag
# POSTGRES_CONTAINER_NAME=nixllm-postgres
# POSTGRES_VOLUME_DATA=nixllm-pgdata
# POSTGRES_RESTART=unless-stopped
# POSTGRES_LIMIT_CPUS=1.0
# POSTGRES_LIMIT_MEM=512M
# POSTGRES_LOG_MAX_SIZE=10m
# POSTGRES_LOG_MAX_FILE=5

# When the `full` profile is active, nixllm connects to the bundled postgres
# via this DSN. Override only if you point at an external database instead.
# PGSTORE_DSN=postgresql://nixllm:change-me@nixllm-postgres:5432/nixllm?sslmode=disable
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/var/lib/nixllm
# PGSTORE_POLICY_CACHE_TTL=5s
# PGSTORE_USAGE_FLUSH_INTERVAL=10s
# PGSTORE_USAGE_FLUSH_BATCH=100
# PGSTORE_USAGE_QUEUE_CAP=10000
# PGSTORE_USAGE_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Resource caps + logging
# -----------------------------------------------------------------------------
# NIXLLM_LIMIT_CPUS=2.0
# NIXLLM_LIMIT_MEM=1G
# NIXLLM_RESERVE_MEM=128M
# NIXLLM_LOG_MAX_SIZE=10m
# NIXLLM_LOG_MAX_FILE=5

# Healthcheck (hits GET /healthz).
# NIXLLM_HEALTH_INTERVAL=30s
# NIXLLM_HEALTH_TIMEOUT=10s
# NIXLLM_HEALTH_RETRIES=3
# NIXLLM_HEALTH_START_PERIOD=30s

# -----------------------------------------------------------------------------
# Optional edge proxy: Caddy (`--profile caddy`)
# -----------------------------------------------------------------------------
# NIXLLM_DOMAIN=llm.example.com           # REQUIRED for the caddy profile
# ACME_EMAIL=you@example.com              # leave empty to use Caddy's internal CA
# CADDY_TAG=2-alpine
# CADDY_CONTAINER_NAME=nixllm-caddy

# -----------------------------------------------------------------------------
# Optional edge proxy: Traefik (`--profile traefik`)
# -----------------------------------------------------------------------------
# NIXLLM_DOMAIN=llm.example.com           # REQUIRED for the traefik profile
# ACME_EMAIL=you@example.com              # REQUIRED for the traefik profile
# TRAEFIK_TAG=3
# TRAEFIK_CONTAINER_NAME=nixllm-traefik

# -----------------------------------------------------------------------------
# Build-time injection (used by `docker compose build`)
# -----------------------------------------------------------------------------
# VERSION=dev
# CORE_VERSION=unknown
# COMMIT=none
# BUILD_DATE=unknown
