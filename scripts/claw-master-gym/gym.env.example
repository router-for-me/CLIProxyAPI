# Profile names only. Never put OAuth tokens or copied credential contents here.
# Each lane owns an exclusive, disjoint profile set for the full run.
CLAW_MASTER_GYM_LANE_A_PROFILES=claude-gym-a
CLAW_MASTER_GYM_LANE_B_PROFILES=claude-gym-b

# Optional: also expose each interactive session through native Remote Control.
# CLAW_MASTER_GYM_REMOTE_CONTROL=1

